---
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import '../styles/site.css';

const {
  title = 'Bowen Yu',
  description = 'Bowen Yu personal website.',
  page = '',
  comments = true,
} = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="/analytics.css">
    <script is:inline src="/analytics-config.js" defer></script>
    <script is:inline src="/analytics.js?v=2" defer></script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" href="/images/favicon.ico" sizes="any">
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/images/apple-touch-icon-180x180.png" sizes="180x180">
    <link rel="manifest" href="/images/manifest.json">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">
    <script is:inline>
      const themeOverrideKey = 'theme-override';
      let themeOverride;
      try {
        themeOverride = JSON.parse(localStorage.getItem(themeOverrideKey) || 'null');
      } catch {
        // Automatic mode also works when storage is unavailable.
      }
      const nextThemeBoundary = (now) => {
        const boundary = new Date(now);
        const hour = now.getHours();
        boundary.setHours(hour < 7 ? 7 : hour < 19 ? 19 : 31, 0, 0, 0);
        return boundary.getTime();
      };
      const refreshTheme = () => {
        const now = new Date();
        const hour = now.getHours();
        const automaticTheme = hour >= 7 && hour < 19 ? 'light' : 'dark';
        const validOverride = themeOverride
          && (themeOverride.theme === 'light' || themeOverride.theme === 'dark')
          && Number.isFinite(themeOverride.expiresAt)
          && themeOverride.expiresAt > now.getTime();
        document.documentElement.dataset.theme = validOverride ? themeOverride.theme : automaticTheme;
      };
      refreshTheme();
    </script>
  </head>
  <body data-page={page}>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">Bowen Yu</a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/publications/" data-nav="publications">Publications</a>
          <a href="/blogs/" data-nav="blogs">Blogs</a>
          <a href="/projects/" data-nav="projects">Projects</a>
          <a href="/files/cv.pdf" target="_blank" rel="noreferrer">CV</a>
          <button class="theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
            <span data-theme-icon="light"><Icon name="moon" size={17} /></span>
            <span data-theme-icon="dark" hidden><Icon name="sun" size={17} /></span>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    {comments && <Comments />}

    <footer class="site-footer">
      <p>© {year} Bowen Yu <span data-page-views hidden style="margin-left: 1rem"></span></p>
      <p><a href="https://github.com/bowenyu066/bowenyu066.github.io" target="_blank" rel="noreferrer">Source</a></p>
    </footer>

    <script is:inline>
      const page = document.body.dataset.page;
      document.querySelector(`[data-nav="${page}"]`)?.setAttribute('aria-current', 'page');

      const button = document.querySelector('[data-theme-toggle]');
      const lightIcon = document.querySelector('[data-theme-icon="light"]');
      const darkIcon = document.querySelector('[data-theme-icon="dark"]');

      const syncIcons = () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        if (lightIcon && darkIcon) {
          lightIcon.hidden = isDark;
          darkIcon.hidden = !isDark;
        }
        const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
      };
      let giscusReadyWindow;
      let lastGiscusTheme;
      const syncGiscusTheme = () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        const iframe = document.querySelector('iframe.giscus-frame');
        if (!giscusReadyWindow || iframe?.contentWindow !== giscusReadyWindow || theme === lastGiscusTheme) return;
        giscusReadyWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
        lastGiscusTheme = theme;
      };

      let themeTimer;
      const syncTheme = () => {
        refreshTheme();
        syncIcons();
        syncGiscusTheme();
        clearTimeout(themeTimer);
        const now = new Date();
        // Recheck at least once a minute for local clock/timezone changes.
        themeTimer = setTimeout(syncTheme, Math.min(nextThemeBoundary(now) - now.getTime(), 60_000));
      };

      syncTheme();
      button?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        themeOverride = { theme: next, expiresAt: nextThemeBoundary(new Date()) };
        try {
          localStorage.setItem(themeOverrideKey, JSON.stringify(themeOverride));
        } catch {
          // Keep the override for this page when storage is unavailable.
        }
        syncTheme();
      });
      window.addEventListener('focus', syncTheme);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) syncTheme();
      });
      window.addEventListener('storage', (event) => {
        if (event.key !== themeOverrideKey && event.key !== null) return;
        try {
          themeOverride = JSON.parse(event.newValue || 'null');
        } catch {
          themeOverride = null;
        }
        syncTheme();
      });
      window.addEventListener('message', (event) => {
        const iframe = document.querySelector('iframe.giscus-frame');
        if (event.origin !== 'https://giscus.app' || !iframe?.contentWindow || event.source !== iframe.contentWindow) return;
        if (giscusReadyWindow !== event.source) lastGiscusTheme = undefined;
        giscusReadyWindow = event.source;
        syncGiscusTheme();
      });

      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (header) header.dataset.scrolled = window.scrollY > 4 ? 'true' : 'false';
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
