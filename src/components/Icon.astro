{name === 'list' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" {...ariaProps}>
    <path d="M4 6h1m4 0h11M4 12h1m4 0h11M4 18h1m4 0h11"/>
