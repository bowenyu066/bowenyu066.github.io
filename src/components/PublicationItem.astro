---
const { publication } = Astro.props;
const data = publication.data;

const formatDate = (date) => new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'short',
  timeZone: 'UTC',
}).format(date);

const venueLabel = data.venue ? data.venue : 'In review';
const isInReview = !data.venue;
const detailHref = `/publications/${publication.id}/`;
const [beforeMe, afterMe = ''] = data.authors.split('Bowen Yu');
---

<li class="pub-item">
  <a class="pub-thumb" href={detailHref} aria-label={`Open ${data.title}`}>
    <img src={data.image} alt={data.imageAlt || data.title} loading="lazy">
  </a>
  <div class="pub-body">
    <h3><a href={detailHref}>{data.title}</a></h3>
    <p class="pub-authors">{beforeMe}<strong>Bowen Yu</strong>{afterMe}</p>
    {data.authorNote && <p class="pub-note">{data.authorNote}</p>}
    <p class="pub-venue">
      <span class:list={['venue-label', { 'is-status': isInReview }]}>{venueLabel}</span>
      <span class="meta-separator" aria-hidden="true">·</span>
      <span class="meta">
        {data.publicationDate && <>
          {data.paperUrl ? <a class="publication-source-link" href={data.paperUrl} target="_blank" rel="noreferrer">Published</a> : <span>Published</span>}
          {' '}{formatDate(data.publicationDate)}{' · '}
        </>}
        {data.arxivUrl ? <a class="publication-source-link" href={data.arxivUrl} target="_blank" rel="noreferrer">arXiv</a> : <span>arXiv</span>}
        {' '}{formatDate(data.arxivDate)}
      </span>
    </p>
    <p class="pub-summary">{data.summary}</p>
  </div>
</li>
