---
const repo = 'bowenyu066/bowenyu066.github.io';
---

<section class="comments-shell" aria-label="Comments">
  <script is:inline define:vars={{ repo }}>
    const giscusScript = document.createElement('script');
    giscusScript.src = 'https://giscus.app/client.js';
    giscusScript.async = true;
    giscusScript.crossOrigin = 'anonymous';
    Object.assign(giscusScript.dataset, {
      repo,
      repoId: 'R_kgDOOSbJ2A',
      category: 'Announcements',
      categoryId: 'DIC_kwDOOSbJ2M4CsmZz',
      mapping: 'pathname',
      strict: '0',
      reactionsEnabled: '1',
      emitMetadata: '0',
      inputPosition: 'bottom',
      theme: document.documentElement.dataset.theme,
      lang: 'en',
    });
    document.currentScript.parentElement.append(giscusScript);
  </script>
</section>
