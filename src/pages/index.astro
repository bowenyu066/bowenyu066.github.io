---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ContentCard from '../components/ContentCard.astro';
import Icon from '../components/Icon.astro';

const publications = await getCollection('publications');
const highlighted = publications
  .filter((publication) => publication.data.highlighted)
  .sort((a, b) => (a.data.highlightOrder ?? 999) - (b.data.highlightOrder ?? 999));

const highlightedBlogs = (await getCollection('blogs'))
  .filter((entry) => entry.data.show)
  .filter((entry) => entry.data.highlighted)
  .sort((a, b) => (a.data.highlightOrder ?? 999) - (b.data.highlightOrder ?? 999));

const highlightedProjects = (await getCollection('projects'))
  .filter((entry) => !entry.data.draft)
  .filter((entry) => entry.data.highlighted)
  .sort((a, b) => (a.data.highlightOrder ?? 999) - (b.data.highlightOrder ?? 999));

const experiences = [
  {
    organization: 'Citadel Securities',
    role: 'Quantitative Research Analyst',
    period: 'Jun 2026 — Present',
    location: 'Miami, FL',
    summary: 'Summer quantitative research in systematic equities.',
  },
  {
    organization: 'ByteDance',
    role: 'Large Language Model Data Researcher',
    period: 'Aug — Sep 2025',
    location: 'Beijing, China',
    summary: 'Built a 500+ problem physics benchmark and a test-time scaling pipeline for frontier LLM reasoning.',
  },
  {
    organization: 'Intel Corporation',
    role: 'AI Workload Deployment Intern',
    period: 'Jun — Jul 2025',
    location: 'Shanghai, China',
    summary: 'Developed GPU memory-layout tutorials and CuTeDSL performance references for AI workloads.',
  },
];
---

<BaseLayout title="Bowen Yu" description="Bowen Yu — undergraduate at MIT, working on machine learning for condensed matter physics and materials science." page="home">
  <main>
    <section class="hero">
      <div class="hero-text">
        <h1>
          Bowen Yu
          <span class="name-zh">余博文</span>
          <bdi class="name-ipa" aria-label="Mandarin pronunciation of Yu Bowen in narrow IPA"><a href="https://en.wikipedia.org/wiki/International_Phonetic_Alphabet" target="_blank" rel="noreferrer">IPA</a>: [y˧˥ po˧˥ wən˧˥]</bdi>
        </h1>
        <p class="hero-tag">Undergraduate, MIT Physics &amp; AI</p>

        <div class="bio">
          <p>
            I'm an undergraduate at MIT (Class of 2027), double-majoring in Physics (Course 8) and
            Artificial Intelligence (Course 6-4). Before MIT I spent a year studying physics at Peking University.
          </p>
          <p>
            I work with Prof. <a href="https://web.mit.edu/nse/people/faculty/mli.html" target="_blank" rel="noreferrer">Mingda Li</a>
            in the <a href="https://qm.mit.edu" target="_blank" rel="noreferrer">MIT Quantum Measurement Group</a>
            on machine learning for condensed matter physics, materials discovery, and defect engineering, supervised by <a href="https://vipandyc.github.io/" target="_blank" rel="noreferrer">Mouyang Cheng</a>.
            I also work with Prof. <a href="https://web.mit.edu/nse/people/faculty/mli.html" target="_blank" rel="noreferrer">Kaiming He</a> on computer vision and generative modeling, supervised by <a href="https://lambertae.github.io/" target="_blank" rel="noreferrer">Ming-Yang Deng</a>.
          </p>
          <p>
            Outside the lab, I enjoy long-distance running, classic films, linguistics, philosophy, vibe-coding projects, and Liu Cixin's novels.
          </p>
        </div>

        <div class="socials" aria-label="Contact">
          <a href="mailto:bowenyu@mit.edu" aria-label="Email"><Icon name="mail" /></a>
          <a href="https://github.com/bowenyu066" target="_blank" rel="noreferrer" aria-label="GitHub"><Icon name="github" /></a>
          <a href="https://www.linkedin.com/in/bowen-yu-6350802bb" target="_blank" rel="noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a href="https://www.zhihu.com/people/uni-fish" target="_blank" rel="noreferrer" aria-label="Zhihu"><Icon name="zhihu" /></a>
        </div>
      </div>

      <figure class="portrait">
        <img src="/images/me_6.jpg" alt="Bowen Yu" loading="eager">
      </figure>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Selected publications</h2>
        <a class="section-link" href="/publications/">All publications <Icon name="arrow-right" size={14} /></a>
      </div>
      <ol class="pub-list" data-numbered="true">
        {highlighted.map((publication) => <PublicationItem publication={publication} />)}
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Experience</h2>
        <a class="section-link" href="/files/cv.pdf" target="_blank" rel="noreferrer">
          View full experience <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <ol class="experience-list">
        {experiences.map((experience) => (
          <li class="experience-item">
            <div class="experience-meta">
              <p class="experience-period">{experience.period}</p>
              <p class="experience-location">{experience.location}</p>
            </div>
            <div class="experience-body">
              <h3>{experience.organization}</h3>
              <p class="experience-role">{experience.role}</p>
              <p class="experience-summary">{experience.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Highlighted posts</h2>
        <a class="section-link" href="/blogs/">All posts <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="card-grid">
        {highlightedBlogs.map((entry) => <ContentCard entry={entry} type="blogs" />)}
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Highlighted projects</h2>
        <a class="section-link" href="/projects/">All projects <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="card-grid">
        {highlightedProjects.map((entry) => <ContentCard entry={entry} type="projects" />)}
      </div>
    </section>
  </main>
</BaseLayout>
