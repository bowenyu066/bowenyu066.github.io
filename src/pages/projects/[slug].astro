---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const formatDate = (date) => new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<BaseLayout title={`${data.title} | Bowen Yu`} description={data.excerpt} page="projects">
  <main>
    <article class="article">
      <a class="back-link" href="/projects/">← Projects</a>
      <header class="article-header">
        <h1>{data.title}</h1>
        <p class="article-meta">{formatDate(data.date)}</p>
        {data.tags && (
          <div class="tag-row">
            {data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
        {data.links && (
          <div class="article-actions">
            {data.links.map((link) => (
              <a href={link.url} target="_blank" rel="noreferrer">
                <Icon name="external" size={15} />{link.label}
              </a>
            ))}
          </div>
        )}
      </header>

      {data.image && data.showHeroImage && <img class="article-hero-image" src={data.image} alt={data.imageAlt || data.title}>}

      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
